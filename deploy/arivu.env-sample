ARIVU_ADDR=127.0.0.1:8080
ARIVU_DB=/var/lib/arivu/arivu.sqlite3
APP_URL=https://arivu.example.com
COOKIE_SECURE=true
SIGNUPS_ENABLED=false
ADMIN_EMAILS=admin@example.com
SECRET_KEY=replace-with-at-least-32-random-bytes
ARIVU_FETCH_USER_AGENT=Arivu/2.0
# Logical live artifact bytes allowed per user (shared objects count per reference).
ARIVU_ARTIFACT_QUOTA_BYTES=1073741824
# Minimum age for stale staging and unreferenced object cleanup.
ARIVU_ASSET_GC_GRACE=24h
# Optional first-party isolated capture service. Keep disabled unless the
# capture bundle is installed and arivu-capture.service is healthy.
ARIVU_BROWSER_CAPTURE_ENABLED=false
ARIVU_BROWSER_CAPTURE_PROTOCOL=2
ARIVU_BROWSER_CAPTURE_SOCKET=/run/arivu-capture/helper.sock
ARIVU_BROWSER_CAPTURE_RUNTIME_DIR=/run/arivu-capture/attempts
ARIVU_BROWSER_CAPTURE_SCREENSHOT=true
ARIVU_BROWSER_CAPTURE_PDF=false
ARIVU_BROWSER_CAPTURE_SELF_CONTAINED_HTML=true
ARIVU_BROWSER_CAPTURE_TIMEOUT=90s
ARIVU_BROWSER_CAPTURE_NAVIGATION_TIMEOUT=30s
ARIVU_BROWSER_CAPTURE_MAX_FILE_BYTES=52428800
ARIVU_BROWSER_CAPTURE_MAX_TOTAL_BYTES=104857600
ARIVU_BROWSER_CAPTURE_MAX_MEDIA_FILES=40
ARIVU_BROWSER_CAPTURE_MAX_MEDIA_FILE_BYTES=5242880
ARIVU_BROWSER_CAPTURE_MAX_MEDIA_TOTAL_BYTES=41943040

# Optional provider integrations can also be set in Admin > Settings. Keep them
# empty here for normal installer-managed hosts.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
X_INTEGRATION_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://arivu.example.com/settings?section=connections
