ARIVU_ADDR=127.0.0.1:8080
ARIVU_DB=/var/lib/arivu/arivu.sqlite3
APP_URL=https://arivu.example.com
COOKIE_SECURE=true
SIGNUPS_ENABLED=false
ADMIN_EMAILS=admin@example.com
SECRET_KEY=replace-with-at-least-32-random-bytes
ARIVU_FETCH_USER_AGENT=Arivu/2.0
# Logical live artifact bytes allowed per user (shared objects count per reference).
ARIVU_ARTIFACT_QUOTA_BYTES=1073741824
# Minimum age for stale staging and unreferenced object cleanup.
ARIVU_ASSET_GC_GRACE=24h
# Optional external browser helper (no browser is bundled). HTML is always the
# only default helper format; screenshot/PDF require their own explicit flags.
ARIVU_BROWSER_CAPTURE_ENABLED=false
ARIVU_BROWSER_CAPTURE_COMMAND=/usr/local/bin/arivu-browser-helper
ARIVU_BROWSER_CAPTURE_SCREENSHOT=false
ARIVU_BROWSER_CAPTURE_PDF=false
ARIVU_BROWSER_CAPTURE_SELF_CONTAINED_HTML=false
ARIVU_BROWSER_CAPTURE_TIMEOUT=30s
ARIVU_BROWSER_CAPTURE_MAX_FILE_BYTES=10485760
ARIVU_BROWSER_CAPTURE_MAX_TOTAL_BYTES=20971520

# Optional provider integrations can also be set in Admin > Settings. Keep them
# empty here for normal installer-managed hosts.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
X_INTEGRATION_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://arivu.example.com/settings?section=connections
