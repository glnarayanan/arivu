#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Arivu uses embedded SQLite and has no persistent development services to
# reconnect after an orb wakes. Fail clearly if the setup snapshot is missing.
command -v go >/dev/null || {
	echo "Go is unavailable; rerun .agents/setup" >&2
	exit 1
}
command -v node >/dev/null || {
	echo "Node.js is unavailable; rerun .agents/setup" >&2
	exit 1
}

echo "Orb resume check complete."
