# Settings for the root compose.yaml. Copy to .env next to compose.yaml, or
# enter the same names in your PaaS environment (Dokploy writes them to .env).
# openwiki/operations/deployment.md ("Compose / PaaS") lists every setting.

# Required.
APP_URL=https://arivu.example.com
ADMIN_EMAILS=admin@example.com
# At least 32 random bytes, for example: openssl rand -hex 32
# Reuse the old value when moving an existing install.
SECRET_KEY=

# Optional (defaults shown).
# COOKIE_SECURE=true
# SIGNUPS_ENABLED=false
# ARIVU_BROWSER_CAPTURE_ENABLED=true
# ARIVU_BROWSER_CAPTURE_SCREENSHOT=true
# ARIVU_BROWSER_CAPTURE_SELF_CONTAINED_HTML=true
# ARIVU_BROWSER_CAPTURE_PDF=false
# ARIVU_CAPTURE_MEM_LIMIT=1536m
# ARIVU_CAPTURE_TMP_SIZE=1g
# ARIVU_VERSION=
# ARIVU_IMAGE_TAG=local
